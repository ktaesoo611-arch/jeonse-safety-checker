# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Korean Government API Keys
MOLIT_API_KEY=your_molit_api_key  # Get from data.go.kr

# Google Vision API (for OCR)
GOOGLE_VISION_API_KEY=your_google_vision_key
GOOGLE_VISION_CREDENTIALS_PATH=./credentials/google-vision.json

# Toss Payments (for payment processing)
TOSS_PAYMENTS_CLIENT_KEY=your_toss_client_key
TOSS_PAYMENTS_SECRET_KEY=your_toss_secret_key

# Resend Email Service
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=support@krent-safety.com
NEXT_PUBLIC_APP_URL=https://krent-safety.com

# CODEF API (primary - 등기부등본 structured JSON)
# Sign up at https://codef.io/ and apply for 부동산등기부등본 API access
# Leave empty to use sandbox mode (fixed test responses)
CODEF_MODE=demo
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=

# IROS (인터넷등기소) credentials - required for actual registry lookups
# Register at http://www.iros.go.kr/ and purchase 선불전자지급수단 (prepaid e-money)
# CODEF_IROS_PASSWORD is a 4-digit PIN you set (RSA encrypted automatically)
CODEF_IROS_ID=
CODEF_IROS_PASSWORD=
CODEF_IROS_PHONE=

# 선불전자지급수단 (전자민원캐시) - purchase at minwon.cashgate.co.kr
# ePrepayNo is 12 digits (e.g., D16392052189)
# ePrepayPass is 4-9 digits (NOT encrypted)
CODEF_EPREPAY_NO=
CODEF_EPREPAY_PASS=

# Registry API Provider: 'codef' or 'apick'
# Use 'codef' when subscription is active (~₩800K/month), 'apick' as fallback
# Default: 'apick' (more cost-effective at low traffic)
REGISTRY_API_PROVIDER=apick

# APick API (fallback - 등기부등본 binary Excel/PDF)
APICK_API_KEY=

# Building Registry API
BUILDING_REGISTRY_API_KEY=

# Beta Testing
# Comma-separated emails that bypass the free beta counter (no decrement on unlock)
BETA_TEST_EMAILS=

# Environment
NODE_ENV=development
